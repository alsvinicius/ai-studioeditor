# Optional. Configure a Google OAuth Web application client JSON outside Git.
YOUTUBE_CLIENT_SECRETS=/run/secrets/client_secret.json
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
# Default Whisper model for new projects; each analysis can choose tiny/base/small/medium/large-v3.
WHISPER_MODEL=medium
# O OpenCode do host precisa estar autenticado (`opencode auth login`).
# O Compose monta este arquivo como somente leitura para o backend.
OPENCODE_AUTH_FILE=${HOME}/.local/share/opencode/auth.json

# Autenticação do Codex CLI (opcional; configure e selecione Codex em /settings).
CODEX_AUTH_FILE=${HOME}/.codex/auth.json
